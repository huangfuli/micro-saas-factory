FACTORY_MIN_SCORE=65
SCOUT_TOP_N=20
SCOUT_GITHUB_ENABLED=1
ANALYST_TOP_N=5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_CODE_MODEL=gpt-5.6-sol

# Product repository publishing with local gh CLI
GITHUB_OWNER=huangfuli
PRODUCT_REPO_VISIBILITY=private

# Non-interactive Vercel CLI deployment
VERCEL_TOKEN=

# Lemon Squeezy: use TEST MODE values before store activation.
# After approval, copy the real product to live mode and replace all IDs/keys.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Review-ready public website information.
# These must be real. Do not use placeholders or invented claims.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_REFUND_POLICY_TEXT=

# Set to 1 only after a human checks that:
# - business description is truthful
# - website matches the actual SaaS
# - pricing matches the configured Lemon Squeezy variant
# - no fake customers/testimonials/metrics/partnerships are shown
MERCHANT_REVIEW_ATTESTED=0
