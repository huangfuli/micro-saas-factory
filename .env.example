# Scout scoring gate
FACTORY_MIN_SCORE=65
SCOUT_TOP_N=20

# Public GitHub issue search can be disabled if rate-limited.
SCOUT_GITHUB_ENABLED=1

# Analyst only researches the top PASS opportunities.
ANALYST_TOP_N=5

# Optional AI enhancement:
# --web-research uses web_search in Analyst
# --pm-ai uses Structured Outputs in Product Manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
